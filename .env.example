# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Payload CMS
PAYLOAD_SECRET=your-secret-key-here-min-32-chars-long

# One-shot catalogue seed (POST /api/seed with header x-setup-token).
# Leave SETUP_TOKEN empty in production once seeding is done — an empty value
# disables the endpoint entirely.
SETUP_TOKEN=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ТЕХНОЛЕС

# Object storage for /admin uploads — Cloudflare R2 (S3-compatible).
# Uploads stay on the local filesystem until ALL FOUR are set, which is fine
# locally and wrong in production: Vercel's filesystem is wiped on every deploy.
#
# Cloudflare dashboard → R2 → Create bucket, then "Manage R2 API Tokens"
# → Create token (Object Read & Write) for that bucket.
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# myPOS (Payment)
MYPOS_STORE_ID=
MYPOS_PRIVATE_KEY=
MYPOS_IPN_URL=

# Resend (Email)
RESEND_API_KEY=

# Analytics — leave blank per deployment. These are per-property IDs; copying
# Bulgaria's into another market makes that market report into Bulgaria's
# figures. No loading code exists yet, and a consent banner is required before
# any of them is switched on.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
